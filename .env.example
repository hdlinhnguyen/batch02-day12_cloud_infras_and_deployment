# --- FastAPI Server Cfg ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production
AGENT_API_KEY=demo-key-change-in-production

# --- Redis Store URL ---
REDIS_URL=redis://localhost:6379/0

# --- Security Limits ---
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0

# --- LLM Cfg (Choose: openrouter, openai, gemini, anthropic) ---
PROVIDER_NAME=openrouter
MODEL_NAME=openai/gpt-4o-mini

# --- Model Provider API Keys ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Research Tools API Keys ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day04-Research-Agent/1.0 (educational lab)
